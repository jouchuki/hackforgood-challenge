# Copy this file to integrations/discord/.env. Never commit the real file.
DISCORD_BOT_TOKEN=YOUR_BOT_TOKEN
DISCORD_APPLICATION_ID=YOUR_APPLICATION_ID
DISCORD_TEST_GUILD_ID=YOUR_PRIVATE_TEST_GUILD_ID

# Local configuration endpoint used only by the locally hosted bot.
BEFORE_API_ORIGIN=http://127.0.0.1:3000
BEFORE_SITE_ID=demo-forum
BEFORE_COUNTRY=NL

# Leave empty for native-only support. A remote member cannot open localhost.
BEFORE_PUBLIC_ORIGIN=
BEFORE_ALLOW_LOCAL_LINKS=false
